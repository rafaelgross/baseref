# PRISMA-SLR — .gitignore

# ─── Configuração local (não commitar credenciais) ───────────
# auth.php tem o Client ID/Secret do Google OAuth; database.php tem a senha
# do MySQL. Versões de exemplo sem segredos: config/*.example.php
config/auth.php
config/database.php
config/database.local.php
config/*.local.php
.env
.env.local

# ─── Uploads temporários ─────────────────────────────────────
uploads/
tmp/
*.bib.tmp

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/

# ─── Sistema operacional ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE / Editores ──────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ─── PHP ─────────────────────────────────────────────────────
vendor/
composer.lock

# ─── Node (caso use npm para assets) ─────────────────────────
node_modules/
package-lock.json
yarn.lock
dist/
.npm

# ─── Cache ───────────────────────────────────────────────────
.cache/
*.cache

# ─── Backup / exports temporários ────────────────────────────
*.sql.bak
*.csv.tmp
export_temp/
