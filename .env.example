# =================================================================
# BaseRef - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# =================================================================

# -----------------------------------------------------------------
# Database (MySQL / MariaDB)
# -----------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=prisma_slr
DB_USER=baseref
DB_PASS=baseref_secret_password
DB_CHARSET=utf8mb4

# Root password for MariaDB container (used by Docker Compose)
DB_ROOT_PASSWORD=baseref_root_secret

# -----------------------------------------------------------------
# Google OAuth 2.0 Credentials
# Get them from: https://console.cloud.google.com/
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For local Docker: http://localhost:8080/auth/callback.php or http://localhost/auth/callback.php
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback.php
GOOGLE_SCOPES=openid email profile
SESSION_LIFETIME=28800

# -----------------------------------------------------------------
# Optional AI-assisted screening (Groq, Gemini, or Anthropic)
# -----------------------------------------------------------------
# AI_PROVIDER=groq
# AI_API_KEY=gsk_your_groq_api_key
# AI_MODEL=openai/gpt-oss-20b
# AI_DAILY_LIMIT=100

# -----------------------------------------------------------------
# Optional Contact emails for public APIs (polite pool)
# -----------------------------------------------------------------
# OPENALEX_MAILTO=your-email@example.org
# TRANSLATE_CONTACT_EMAIL=your-email@example.org

# -----------------------------------------------------------------
# Application Web Port (Docker host binding)
# -----------------------------------------------------------------
PORT=8080
